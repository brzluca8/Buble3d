extends SubViewportContainer
## Chest Presentation Controller: a real 3D chest (assets/board/chest_<kind>.glb, generated by
## tools/build_characters.py) in its own small world, rendered only while a screen shows it.
## Each tier has its own choreography; nothing here touches the save.
##   wood    rocks on the spot, hops, lid flips open with an overshoot, warm glow and wood chips
##   silver  floats, turns a full circle, studs light up, cool swirl of sparkles, cyan beam
##   gold    the Royal Ceremony: three gems light one by one while the chest trembles harder,
##           the lock pops off, the lid bursts open, a golden pillar of light and a coin shower
signal beat(index: int)
signal opened
const MODELS := {"wood": preload("res://assets/board/chest_wood.glb"), "silver": preload("res://assets/board/chest_silver.glb"),
	"gold": preload("res://assets/board/chest_gold.glb")}
const Polish := preload("res://scripts/board/polish.gd")
const HINGE := Vector3(0,0.6,-0.43)
const ANTICIPATION := {"wood": 0.35, "silver": 0.75, "gold": 1.35}
const LIGHT_COLOR := {"wood": Color(1.0,0.78,0.45), "silver": Color(0.6,0.95,1.0), "gold": Color(1.0,0.86,0.4)}

var kind := "wood"
var viewport := SubViewport.new()
var world := Node3D.new()
var pivot := Node3D.new()
var model: Node3D
var lid: Node3D
var lock: Node3D
var inner: MeshInstance3D
var gems: Array[MeshInstance3D] = []
var camera := Camera3D.new()
var beam := MeshInstance3D.new()
var beam_material := StandardMaterial3D.new()
var halo := MeshInstance3D.new()
var halo_material := StandardMaterial3D.new()
var lid_angle := 0.0
var glow := 0.0
var shake := 0.0
var age := 0.0
var idle_on := true
var reduced := false
var tween: Tween
var hop := 0.0
var spin := 0.0
var rest_spin := -0.35


func _init() -> void:
	stretch = true
	mouse_filter = Control.MOUSE_FILTER_IGNORE


func _ready() -> void:
	viewport.transparent_bg = true
	viewport.own_world_3d = true
	viewport.msaa_3d = Viewport.MSAA_2X
	viewport.render_target_update_mode = SubViewport.UPDATE_WHEN_VISIBLE
	add_child(viewport)
	viewport.add_child(world)
	var env := WorldEnvironment.new()
	env.environment = Environment.new()
	env.environment.background_mode = Environment.BG_CLEAR_COLOR
	env.environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.environment.ambient_light_color = Color(0.85,0.9,1.0)
	env.environment.ambient_light_energy = 0.55
	world.add_child(env)
	var key := DirectionalLight3D.new()
	key.rotation_degrees = Vector3(-38,-28,0)
	key.light_energy = 1.05
	world.add_child(key)
	var rim := DirectionalLight3D.new()
	rim.rotation_degrees = Vector3(-20,150,0)
	rim.light_energy = 0.55
	rim.light_color = Color(0.6,0.85,1.0)
	world.add_child(rim)
	world.add_child(pivot)
	camera.fov = 34.0
	camera.position = Vector3(0,1.4,3.05)
	world.add_child(camera)
	camera.look_at(Vector3(0,0.58,0))
	camera.current = true
	Polish.make_textures()
	for material: StandardMaterial3D in [beam_material,halo_material]:
		material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		material.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
		material.cull_mode = BaseMaterial3D.CULL_DISABLED
	var column := CylinderMesh.new()
	column.top_radius = 0.75
	column.bottom_radius = 0.45
	column.height = 3.2
	column.radial_segments = 16
	column.cap_top = false
	column.cap_bottom = false
	column.material = beam_material
	beam.mesh = column
	beam.position = Vector3(0,2.2,0)
	beam.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	world.add_child(beam)
	halo_material.albedo_texture = Polish.soft_texture
	halo_material.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	var quad := QuadMesh.new()
	quad.size = Vector2(3.4,3.4)
	quad.material = halo_material
	halo.mesh = quad
	halo.position = Vector3(0,0.55,-0.6)
	world.add_child(halo)
	show_kind(kind)


func show_kind(chest_kind: String) -> void:
	kind = chest_kind
	if not is_inside_tree():
		return
	if tween:
		tween.kill()
	if model:
		model.queue_free()
	model = MODELS[kind].instantiate()
	pivot.add_child(model)
	var paint := StandardMaterial3D.new()
	paint.vertex_color_use_as_albedo = true
	paint.roughness = 0.62 if kind == "wood" else 0.32
	paint.metallic_specular = 0.35 if kind == "wood" else 0.85
	paint.rim_enabled = true
	paint.rim = 0.35 if kind == "wood" else 0.6
	paint.rim_tint = 0.4
	for part: MeshInstance3D in model.find_children("*","MeshInstance3D",true,false):
		part.material_override = paint
	lid = model.find_child("Capac",true,false)
	lock = model.find_child("Lacat",true,false)
	inner = model.find_child("Interior",true,false)
	var glow_paint := StandardMaterial3D.new()
	glow_paint.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	glow_paint.albedo_color = Color(1.0,0.93,0.7)
	inner.material_override = glow_paint
	lid_angle = 0.0
	glow = 0.0
	shake = 0.0
	hop = 0.0
	spin = 0.0
	idle_on = true
	lock.visible = true
	lock.transform = Transform3D.IDENTITY
	pivot.transform = Transform3D.IDENTITY
	_apply()


func anticipation_time() -> float:
	return 0.05 if reduced else float(ANTICIPATION[kind])


## Runs the tier's anticipation and opening. Emits `beat` for each anticipation beat and
## `opened` when the lid is open. Returns the total time until the lid is open.
func play_open() -> float:
	idle_on = false
	if tween:
		tween.kill()
	tween = create_tween()
	if reduced:
		tween.tween_method(_set_lid,0.0,1.0,0.12)
		tween.tween_callback(func() -> void: opened.emit())
		return 0.12
	match kind:
		"wood":
			tween.tween_method(func(t: float) -> void: shake = 0.25*sin(PI*t); hop = -0.06*sin(PI*t),0.0,1.0,0.35)
			tween.tween_callback(func() -> void: beat.emit(0))
			tween.tween_method(func(t: float) -> void: hop = 0.35*sin(PI*t),0.0,1.0,0.3).set_trans(Tween.TRANS_SINE)
			tween.parallel().tween_method(_set_lid,0.0,1.15,0.22).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
			tween.tween_method(_set_lid,1.15,1.0,0.12)
		"silver":
			tween.tween_method(func(t: float) -> void: hop = 0.3*smoothstep(0.0,1.0,t); spin = TAU*smoothstep(0.0,1.0,t); shake = 0.1*t,0.0,1.0,0.75)
			tween.tween_callback(func() -> void: beat.emit(0))
			tween.tween_method(_set_lid,0.0,1.0,0.26).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
			tween.parallel().tween_method(func(t: float) -> void: hop = 0.3*(1.0 - t),0.0,1.0,0.35).set_trans(Tween.TRANS_BOUNCE).set_ease(Tween.EASE_OUT)
		_:
			for i in range(3):
				tween.tween_callback(_light_gem.bind(i))
				tween.tween_method(func(t: float) -> void: shake = (0.25 + 0.3*i)*sin(PI*t),0.0,1.0,0.45)
			tween.tween_callback(_pop_lock)
			tween.tween_method(_set_lid,0.0,1.25,0.18).set_trans(Tween.TRANS_EXPO).set_ease(Tween.EASE_OUT)
			tween.parallel().tween_method(func(t: float) -> void: hop = 0.25*sin(PI*t),0.0,1.0,0.3)
			tween.tween_method(_set_lid,1.25,1.0,0.16).set_trans(Tween.TRANS_SINE)
	tween.tween_callback(func() -> void: opened.emit())
	return anticipation_time() + (0.42 if kind != "silver" else 0.3)


func _set_lid(value: float) -> void:
	lid_angle = value
	glow = clampf(value,0.0,1.0)
	_apply()


func _light_gem(index: int) -> void:
	beat.emit(index)
	_spark(Vector3(-0.25 + 0.25*index,1.0,0.1),Color(["#ff4d6d","#4dd0ff","#6bf08f"][index]),8,1.4)


func _pop_lock() -> void:
	beat.emit(3)
	var fly := create_tween()
	var start := lock.transform
	fly.tween_method(func(t: float) -> void:
		lock.transform = Transform3D(Basis(Vector3.RIGHT,t*5.0)*Basis(Vector3.UP,t*2.0),Vector3(0.3*t,0.9*sin(PI*t*0.8) - 0.4*t*t,0.6*t))*start,0.0,1.0,0.6)
	fly.tween_callback(func() -> void: lock.visible = false)


func _spark(at: Vector3, color: Color, count: int, speed: float) -> void:
	if reduced:
		return
	var quad := QuadMesh.new()
	quad.size = Vector2(0.18,0.18)
	var m := StandardMaterial3D.new()
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	m.vertex_color_use_as_albedo = true
	m.albedo_texture = Polish.star_texture
	m.billboard_mode = BaseMaterial3D.BILLBOARD_ENABLED
	m.billboard_keep_scale = true
	quad.material = m
	var cloud := CPUParticles3D.new()
	cloud.mesh = quad
	cloud.amount = count
	cloud.one_shot = true
	cloud.explosiveness = 0.95
	cloud.lifetime = 0.7
	cloud.spread = 180.0
	cloud.initial_velocity_min = speed*0.4
	cloud.initial_velocity_max = speed
	cloud.gravity = Vector3(0,-1.5,0)
	cloud.color = color
	cloud.scale_amount_curve = Polish._shrink_curve()
	cloud.position = at
	world.add_child(cloud)
	cloud.finished.connect(cloud.queue_free)
	cloud.emitting = true


## Burst once the lid is open: chips (wood), a sparkle swirl (silver), a coin shower (gold).
func burst() -> void:
	if reduced:
		return
	match kind:
		"wood":
			_spark(Vector3(0,0.9,0),Color("#e0a050"),10,2.2)
			_spark(Vector3(0,0.7,0.2),Color("#fff1c0"),6,1.2)
		"silver":
			_spark(Vector3(0,1.0,0),Color("#9fe9ff"),16,2.4)
			_spark(Vector3(0,1.2,0),Color("#ffffff"),10,1.6)
		_:
			_spark(Vector3(0,1.1,0),Color("#ffd04a"),22,3.0)
			_spark(Vector3(0,1.4,0),Color("#fff3b0"),14,2.0)
			_coin_shower()


func _coin_shower() -> void:
	var coin := CylinderMesh.new()
	coin.top_radius = 0.09
	coin.bottom_radius = 0.09
	coin.height = 0.025
	coin.radial_segments = 10
	var m := StandardMaterial3D.new()
	m.albedo_color = Color("#ffcf3a")
	m.metallic = 0.6
	m.roughness = 0.3
	m.emission_enabled = true
	m.emission = Color("#8a5a00")
	coin.material = m
	var rain := CPUParticles3D.new()
	rain.mesh = coin
	rain.amount = 26
	rain.one_shot = true
	rain.explosiveness = 0.6
	rain.lifetime = 1.4
	rain.emission_shape = CPUParticles3D.EMISSION_SHAPE_BOX
	rain.emission_box_extents = Vector3(1.6,0.1,0.6)
	rain.direction = Vector3(0,-1,0)
	rain.initial_velocity_min = 0.5
	rain.initial_velocity_max = 1.5
	rain.gravity = Vector3(0,-6,0)
	rain.angular_velocity_min = -400
	rain.angular_velocity_max = 400
	rain.particle_flag_rotate_y = true
	rain.position = Vector3(0,3.2,0)
	world.add_child(rain)
	rain.finished.connect(rain.queue_free)
	rain.emitting = true


func _process(delta: float) -> void:
	age += delta
	if idle_on and not reduced:
		hop = 0.05*sin(age*2.4) + (0.04 if kind == "silver" else 0.0)
		spin = rest_spin + (0.25*sin(age*0.7) if kind != "wood" else 0.0)
		shake = 0.06*sin(age*1.7) if kind == "wood" else 0.0
	_apply()


func _apply() -> void:
	if model == null:
		return
	var tremble := sin(age*55.0)*shake*0.12
	pivot.transform = Transform3D(Basis(Vector3.UP,spin + (0.0 if idle_on else rest_spin))*Basis(Vector3.BACK,tremble),Vector3(0,hop,0))
	if lid:
		lid.transform = Transform3D(Basis(Vector3.RIGHT,-lid_angle*1.85),HINGE - Basis(Vector3.RIGHT,-lid_angle*1.85)*HINGE)
	var tint: Color = LIGHT_COLOR[kind]
	beam.visible = glow > 0.02 and not reduced
	beam_material.albedo_color = Color(tint,(0.22 if kind != "gold" else 0.42)*glow)
	beam.scale = Vector3(1.0 + 0.1*sin(age*8.0),1.0,1.0 + 0.1*sin(age*8.0))*(1.0 if kind == "gold" else 0.7)
	var breath := 0.5 + 0.5*sin(age*2.0)
	var idle_glow: float = {"wood": 0.0, "silver": 0.18, "gold": 0.32}[kind]*(0.6 + 0.4*breath)
	halo_material.albedo_color = Color(tint,idle_glow + 0.45*glow)
	halo.scale = Vector3.ONE*(1.0 + 0.3*glow)
	if inner:
		inner.visible = lid_angle > 0.05
